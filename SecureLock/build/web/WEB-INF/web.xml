<?xml version="1.0" encoding="UTF-8"?>
<web-app version="4.0" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd">
    <servlet>
        <servlet-name>SenderReg</servlet-name>
        <servlet-class>GeoTemporal.SenderReg</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>SenderLog</servlet-name>
        <servlet-class>GeoTemporal.SenderLog</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>Verifyotp</servlet-name>
        <servlet-class>GeoTemporal.Verifyotp</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ReceiverReg</servlet-name>
        <servlet-class>GeoTemporal.ReceiverReg</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ReceiversLog</servlet-name>
        <servlet-class>GeoTemporal.ReceiversLog</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>RVerifyotp</servlet-name>
        <servlet-class>GeoTemporal.RVerifyotp</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>Upload</servlet-name>
        <servlet-class>GeoTemporal.Upload</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>DownloadFile</servlet-name>
        <servlet-class>GeoTemporal.DownloadFile</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SenderReg</servlet-name>
        <url-pattern>/SenderReg</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>SenderLog</servlet-name>
        <url-pattern>/SenderLog</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>Verifyotp</servlet-name>
        <url-pattern>/Verifyotp</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ReceiverReg</servlet-name>
        <url-pattern>/ReceiverReg</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ReceiversLog</servlet-name>
        <url-pattern>/ReceiversLog</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>RVerifyotp</servlet-name>
        <url-pattern>/RVerifyotp</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>Upload</servlet-name>
        <url-pattern>/Upload</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>DownloadFile</servlet-name>
        <url-pattern>/DownloadFile</url-pattern>
    </servlet-mapping>
    <session-config>
        <session-timeout>
            30
        </session-timeout>
    </session-config>
</web-app>
